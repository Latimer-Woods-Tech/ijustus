{
  "name": "ijustus",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",

  // ── Hyperdrive → OCI Postgres (via @latimer-woods-tech/neon driver) ───────
  // BOUNDARY CONTRACT (capricast#911, estate review 2026-07-18):
  // id 933b8418… = the `ijustus-db` Hyperdrive config. Its origin MUST be the
  // OCI Postgres `neighbor_aid` database (user `neighbor_aid`) — ijustus is
  // neighbor-aid's voice frontend and owns tables organizations / simulators /
  // call_sessions there. It must NEVER point at another product's database
  // (it was misdirected at kairoscouncil PROD until 2026-07-18). Enforced by
  // scripts/check-db-boundary.sh, run pre-deploy in deploy.yml and weekly in
  // .github/workflows/db-boundary-guard.yml.
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "933b84184870481ab097a4506db5a675"
    }
  ],

  // ── Non-secret vars (secrets go in wrangler secret put, never here) ────────
  "vars": {
    "ENVIRONMENT": "production",
    "WORKER_NAME": "ijustus"
  },

  // ── Rate Limiter (auth routes) ────────────────────────────────────────────
  "rate_limiters": [
    {
      "binding": "AUTH_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // ── Staging environment ────────────────────────────────────────────────────
  "env": {
    "staging": {
      "name": "ijustus-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "WORKER_NAME": "ijustus-staging"
      }
    }
  }
}
